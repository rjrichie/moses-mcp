{
  "name": "moses-mcp",
  "version": "0.1.0",
  "description": "MCP server for discovering TU Berlin Moses (Modulverzeichnis/MTS) degree programs and modules",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "moses-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "e2e": "npm run build && tsx scripts/e2e-check.ts",
    "build-usage-index": "tsx scripts/build-usage-index.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
